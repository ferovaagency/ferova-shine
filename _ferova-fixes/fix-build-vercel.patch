+/**
+ * Node envuelve TODO fallo de transporte en un genérico `TypeError: fetch failed`
+ * y guarda el detalle real (`ENOTFOUND`, `ECONNREFUSED`, `UND_ERR_CONNECT_TIMEOUT`,
+ * `unable to verify the first certificate`…) en `error.cause`, a veces anidado o
+ * dentro de un `AggregateError.errors`. Sin desenvolverlo, el log de Vercel dice
+ * "fetch failed" y no hay forma de saber si fue DNS, firewall, TLS o timeout.
+ */
+export function describeError(err: unknown, depth = 0): string {
+  if (depth > 4) return "…";
+  if (!(err instanceof Error)) return String(err);
+  const e = err as Error & {
+    code?: string;
+    errno?: number;
+    syscall?: string;
+    hostname?: string;
+    address?: string;
+    port?: number;
+    cause?: unknown;
+    errors?: unknown[];
+  };
+  const meta = [
+    e.code && `code=${e.code}`,
+    e.errno !== undefined && `errno=${e.errno}`,
+    e.syscall && `syscall=${e.syscall}`,
+    e.hostname && `hostname=${e.hostname}`,
+    e.address && `address=${e.address}`,
+    e.port !== undefined && `port=${e.port}`,
+  ].filter(Boolean) as string[];
+
+  let out = `${e.name}: ${e.message}`;
+  if (meta.length) out += ` (${meta.join(" ")})`;
+
+  const pad = "  ".repeat(depth + 1);
+  if (Array.isArray(e.errors) && e.errors.length) {
+    out += e.errors.map((sub) => `\n${pad}↳ agregado: ${describeError(sub, depth + 1)}`).join("");
+  }
+  if (e.cause !== undefined && e.cause !== null) {
+    out += `\n${pad}↳ causa: ${describeError(e.cause, depth + 1)}`;
+  }
+  return out;
+}
+
+/** Fallo de transporte o de status al consultar UNA fuente. Lo distingue de "consulté y no hay nada". */
+export class SourceUnavailableError extends Error {
+  constructor(readonly source: string, readonly url: string, readonly detail: string) {
+    super(`no se pudo consultar ${source}: ${detail}\n  URL: ${url}`);
+    this.name = "SourceUnavailableError";
+  }
+}
+
+const RETRY_ATTEMPTS = 3;
+const RETRY_DELAYS_MS = [400, 1200];
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/**
+ * Consulta una fuente. Reintenta SOLO lo que puede ser transitorio (error de red,
+ * 5xx, 429). Un 4xx —tabla que no existe, RLS, clave mala— no se reintenta: no va
+ * a cambiar de opinión en 400 ms y reintentarlo solo alarga el build.
+ */
 async function getJson<T>(
   url: string,
   headers: Record<string, string>,
   what: string,
-  scope: string,
 ): Promise<T> {
-  let res: Response;
-  try {
-    res = await fetch(url, { headers });
-  } catch (err) {
-    return fail(scope, `no se pudo consultar ${what}: ${(err as Error).message}\n  URL: ${url}`);
-  }
-  if (!res.ok) {
-    const body = await res.text().catch(() => "");
-    return fail(scope, `${what} devolvió HTTP ${res.status}: ${body.slice(0, 500)}\n  URL: ${url}`);
+  let detail = "sin detalle";
+  for (let attempt = 1; attempt <= RETRY_ATTEMPTS; attempt++) {
+    let transitorio = true;
+    try {
+      const res = await fetch(url, { headers });
+      if (res.ok) return (await res.json()) as T;
+      const body = await res.text().catch(() => "");
+      detail = `HTTP ${res.status}: ${body.slice(0, 500)}`;
+      transitorio = res.status >= 500 || res.status === 429;
+    } catch (err) {
+      detail = describeError(err);
+    }
+    if (!transitorio) break;
+    if (attempt < RETRY_ATTEMPTS) {
+      console.warn(`[dynamic-content] ${what}: intento ${attempt}/${RETRY_ATTEMPTS} falló (${detail.split("\n")[0]}), reintento…`);
+      await sleep(RETRY_DELAYS_MS[attempt - 1] ?? 1200);
+    }
   }
-  return (await res.json()) as T;
+  throw new SourceUnavailableError(what, url, detail);
 }
 
